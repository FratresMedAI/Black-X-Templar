# DARKSPACE environment template
# Copy to .env and replace placeholder values.
# Never commit real secrets.

# Threat feed key (optional in offline mode)
THREATFOX_API_KEY=your_key_here

# Required for production: 32+ byte secret
DARKSPACE_HMAC_SECRET=replace_with_32_plus_byte_random_secret

# Optional paths / modes
DARKSPACE_DB_PATH=audit_log.db
DARKSPACE_OFFLINE_ONLY=false

# P2P trust hardening
DARKSPACE_P2P_REQUIRE_MUTUAL_AUTH=false
DARKSPACE_PEER_FINGERPRINTS=

# Optional kinetic escalation webhook
DARKSPACE_ESCALATE_WEBHOOK=
