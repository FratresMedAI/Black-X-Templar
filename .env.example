# Copy to .env and fill for RunPod / local (never commit secrets).

# --- RunPod production (2× H200 + AWQ-INT4) ---
DARKSPACE_READY_FOR_RUNPOD=true
DARKSPACE_EMBEDDED_VLLM=1
DARKSPACE_JUDGE_INFERENCE=openai
DARKSPACE_LLM_JUDGE=llama-3.1-405b-instruct-4bit
DARKSPACE_OFFLINE_ONLY=false
HF_TOKEN=

# vLLM defaults (override only if needed)
DARKSPACE_VLLM_MODEL_ID=hugging-quants/Meta-Llama-3.1-405B-Instruct-AWQ-INT4
DARKSPACE_VLLM_EXTRA_ARGS=--quantization awq --gpu-memory-utilization 0.90 --max-model-len 8192 --max-num-batched-tokens 4096 --dtype auto --enforce-eager --tensor-parallel-size 2
DARKSPACE_VLLM_PORT=8000

# Gate (embedded vLLM sets these automatically; set manually if using external vLLM)
# DARKSPACE_GATE_BASE_URL=http://127.0.0.1:8000/v1
# DARKSPACE_GATE_MODEL=hugging-quants/Meta-Llama-3.1-405B-Instruct-AWQ-INT4

# API
SAFEGUARD_API_PORT=8080
DARKSPACE_HMAC_SECRET=change_me_to_32_bytes_minimum_secret

# --- Local CPU validation only ---
# DARKSPACE_RUNPOD_VALIDATION=1
# DARKSPACE_MOCK_GATE=1
# SKIP_DOCKER=1
